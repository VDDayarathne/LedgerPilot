# Reference only. Each application documents the variables it currently uses.
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/ledgerpilot
DB_USERNAME=ledgerpilot
DB_PASSWORD=replace-with-a-local-password

FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
VITE_API_URL=/api/v1

AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=ledgerpilot
AUTH_JWT_AUDIENCE=ledgerpilot-web
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

MAIL_FROM=no-reply@ledgerpilot.local
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace-me
SPRING_MAIL_PASSWORD=replace-me

# Reserved for the future AI service; not consumed by current applications.
AI_SERVICE_PORT=8000
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_SHARED_SECRET=replace-me
